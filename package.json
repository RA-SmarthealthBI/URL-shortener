{
  "name": "go-shortener",
  "version": "1.0.0",
  "description": "Self-hosted link shortener with click analytics and QR codes on Cloudflare Workers, KV and D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply go-shortener --remote",
    "db:migrate:local": "wrangler d1 migrations apply go-shortener --local"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RA-SmarthealthBI/URL-shortener.git"
  },
  "bugs": {
    "url": "https://github.com/RA-SmarthealthBI/URL-shortener/issues"
  },
  "homepage": "https://github.com/RA-SmarthealthBI/URL-shortener#readme",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "type": "module"
}
